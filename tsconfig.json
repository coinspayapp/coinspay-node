{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist/cjs",
    "declaration": true,
    "sourceMap": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": false,
    "skipLibCheck": false,
    "stripInternal": true
  },
  "include": ["src"]
}
